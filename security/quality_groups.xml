<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_techstore_quality" model="ir.module.category">
        <field name="name">TechStore Quality</field>
        <field name="description">Permisos del registro de pruebas TechStore</field>
        <field name="sequence">30</field>
    </record>
    <record id="group_quality_reader" model="res.groups">
        <field name="name">Lector</field>
        <field name="category_id" ref="module_category_techstore_quality"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_quality_analyst" model="res.groups">
        <field name="name">Analista</field>
        <field name="category_id" ref="module_category_techstore_quality"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_reader'))]"/>
    </record>
    <record id="group_quality_manager" model="res.groups">
        <field name="name">Administrador de calidad</field>
        <field name="category_id" ref="module_category_techstore_quality"/>
        <field name="implied_ids" eval="[(4, ref('group_quality_analyst'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
