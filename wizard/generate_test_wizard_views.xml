<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_quality_generate_wizard_form" model="ir.ui.view">
        <field name="name">techstore.quality.generate.wizard.form</field>
        <field name="model">techstore.quality.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar datos de prueba">
                <group>
                    <field name="generation_mode" widget="radio"/>
                    <field name="quantity" attrs="{'invisible': [('generation_mode', '=', 'sample')]}"/>
                    <field name="random_seed" attrs="{'invisible': [('generation_mode', '=', 'sample')]}"/>
                    <field name="start_date"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Los datos son ficticios. Al pulsar Generar y guardar se crearán registros reales en Odoo,
                    sin eliminar los anteriores. El modo de ejemplo crea exactamente seis registros.
                </div>
                <footer>
                    <button name="action_generate" type="object" string="Generar y guardar"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_quality_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generar datos de prueba</field>
        <field name="res_model">techstore.quality.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_quality_generate_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
